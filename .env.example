# Copy to .env and fill in. Never commit .env.

# Encrypts Plex and Netdata tokens saved from the Settings screen. Generate once and keep it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# or: docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
SECRET_KEY=

# The only Plex account with administrator access (matched by its Plex email).
# Everyone else who signs in with Plex is a viewer and sees only the sections
# allowed in Settings, Access.
ADMIN_PLEX_EMAIL=cluster@mail.com

# Mark the login cookie Secure. Leave "true" when the site is served over HTTPS
# (it is, behind nginx or Caddy). Set "auto" only for plain-http testing.
COOKIE_SECURE=true

# "auto" shows sample data until the first Plex server is added. "never" disables sample data.
SAMPLE_MODE=auto

LOG_LEVEL=INFO
